list: user.code_macro_like
code.language: rust
-

# Format: `spoken form: macro_name!,L,R` where L and R are the left and right delimiter for the macro respectively.
# Block macros (ex: macro rules) must have their written forms enclosed within dub quotes,
#   as that escapes standard curly brace functionality.

assert equal: assert_eq!,(,)
assert not equal: assert_ne!,(,)
assert: assert!,(,)
concatenate: concat!,(,)
debug: debug!,(,)
error print line: eprintln!,(,)
error: error!,(,)
format: format!,(,)
info: info!,(,)
macro rules: "macro_rules!,{,}"
panic: panic!,(,)
print line: println!,(,)
print: print!,(,)
to do: todo!,(,)
vector: vec!,[,]
warning: warn!,(,)
